# ────────────────────────────────────────────────────────────────────────────
# MediVa web app environment
# Copy to .env for local dev. In production (Vercel) set these in the
# project's Environment Variables dashboard, NOT in a committed file.
# ────────────────────────────────────────────────────────────────────────────

# PostgreSQL with the pgvector extension.
# Local:  docker compose up -d  ->  postgresql://mediva:mediva@localhost:5433/mediva
# Prod:   a managed Postgres + pgvector connection string (e.g. Neon — use the
#         pooled "-pooler" host and append ?sslmode=require).
DATABASE_URL="postgresql://mediva:mediva@localhost:5433/mediva"

# Groq API key for the MediVa tool-calling agent. Get one at https://console.groq.com
GROQ_API_KEY=""
# Tool-use capable Groq model for the agent layer
AGENT_MODEL="llama-3.3-70b-versatile"

# Base URL of the EXISTING FastAPI RAG service (api/main.py).
# Local:  http://localhost:8000
# Prod:   https://<your-render-service>.onrender.com
RAG_API_URL="http://localhost:8000"

# Secret used to sign session cookies. MUST be a long random value in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production"

# Google OAuth (Sign in with Google). Create credentials at
# https://console.cloud.google.com/apis/credentials and add the redirect URI:
#   Local:  http://localhost:3001/api/auth/google/callback
#   Prod:   https://<your-vercel-domain>/api/auth/google/callback
# Leave blank to hide/disable Google sign-in (email + password still works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WhatsApp (Meta WhatsApp Cloud API) for appointment/pickup confirmations.
# Leave blank to run in mock mode (messages are logged + a wa.me link is produced).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
